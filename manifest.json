{
  "manifest_version": 3,
  "name": "WikiMasters — Cotes",
  "version": "1.3.3",
  "description": "Affiche les cotes et l’historique des enchères WikiMasters.",
  "host_permissions": ["https://cyrxjeppjqsxxjayfrur.supabase.co/*"],
  "background": {
    "service_worker": "extension/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
      "js": ["extension/content.js"],
      "css": ["extension/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
