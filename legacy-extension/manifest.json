{
  "manifest_version": 3,
  "name": "WikiMasters — Cotes",
  "version": "1.0.0",
  "description": "Affiche les dernières ventes et les prix moyens des cartes WikiMasters.",
  "host_permissions": ["https://cyrxjeppjqsxxjayfrur.supabase.co/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
